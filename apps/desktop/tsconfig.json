{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noUnusedLocals": true, "allowImportingTsExtensions": true,
    "noUnusedParameters": true, "noEmit": true, "skipLibCheck": true
  },
  "include": ["src"]
}
