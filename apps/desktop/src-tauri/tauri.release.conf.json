{
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Sauvegarde et synchronisation locales avec simulation",
    "externalBin": [
      "binaries/syncengine",
      "binaries/syncengine-agent"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "../../../target/third-party/": "notices/",
      "../../../scripts/state_maintenance.py": "tools/state_maintenance.py",
      "../../../LICENSE": "LICENSE"
    },
    "license": "GPL-3.0-only"
  }
}
